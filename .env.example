
APP_NAME="AI E-Commerce Shop"
APP_ENV=local
APP_KEY=base64:YOUR_EXISTING_APP_KEY
APP_DEBUG=true
APP_DEBUG_ALLOWED_IPS=
APP_URL=http://localhost
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bagisto_shop
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=
